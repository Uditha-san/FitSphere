# ==============================================================================
# FitSphere Local Development Environment Variables
# ==============================================================================

# Project
PROJECT_NAME="FitSphere"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_USER=fitsphere_user
POSTGRES_PASSWORD=fitsphere_local_password
POSTGRES_DB=fitsphere_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fitsphere_user:fitsphere_local_password@localhost:5432/fitsphere_db

# Cache & Queues (Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fitsphere_user
RABBITMQ_PASSWORD=fitsphere_local_password
RABBITMQ_URL=amqp://fitsphere_user:fitsphere_local_password@localhost:5672/

# Backend Security (JWT & Hashing)
SECRET_KEY=fitsphere_insecure_local_dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend
VITE_API_URL=http://localhost:8000
